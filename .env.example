# Contact form: sends each enquiry to your inbox through Resend (https://resend.com).
RESEND_API_KEY=
# Where enquiries go
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, for example "jacobdelega.com <hello@jacobdelega.com>"
CONTACT_FROM_EMAIL=
# Optional: a Cal.com or Calendly link, shown after someone sends the form
NEXT_PUBLIC_BOOKING_URL=
